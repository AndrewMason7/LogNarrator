# ==============================================================================
# LogNarrator Environment Configuration Template
# Copy this file to .env and configure your desired settings.
# ==============================================================================

# ==============================================================================
# 1. AI MODEL & AUTHENTICATION SETTINGS
# (Choose ONE of the three authentication modes below)
# ==============================================================================

# ------------------------------------------------------------------------------
# Mode A: Google Gemini Developer API (Direct API Key)
# ------------------------------------------------------------------------------
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=
# Default model identifier (uncomment to override SDK default)
# LOG_NARRATOR_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Mode B: Google Cloud Vertex AI (Standard Mode ADC)
# ------------------------------------------------------------------------------
# Zero API keys required. Authenticate locally via:
#   gcloud auth application-default login
# LOG_NARRATOR_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ------------------------------------------------------------------------------
# Mode C: Local / Offline Models (Ollama, vLLM, LM Studio)
# ------------------------------------------------------------------------------
# Air-gapped zero-cloud operation. No API keys needed.
# LOCAL_MODEL_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=gemma2:9b


# ==============================================================================
# 2. TOOL SETTINGS (LOGNARRATOR PIPELINE & INGESTION)
# ==============================================================================

# Narrative response mode: 'diagnostic' (detailed root causes + fixes) or 'concise' (1-2 sentence status)
LOG_NARRATOR_MODE=diagnostic

# Output presentation sink: 'rich_tui' (split-screen terminal), 'stdout' (plain text)
LOG_NARRATOR_SINK=rich_tui

# Target language for AI narratives (e.g. English, Spanish, Japanese, German, French)
LOG_NARRATOR_TARGET_LANGUAGE=English

# Pacing debounce interval in seconds before flushing a log batch to the AI
LOG_NARRATOR_DEBOUNCE_SECONDS=1.5

# Maximum number of log lines in a single processing batch
LOG_NARRATOR_MAX_BATCH_LINES=50

# Root directory of your codebase for inspecting stack trace files (defaults to current directory)
# LOG_NARRATOR_CODE_ROOT=.

# Enable or disable automated source code inspection for stack traces
LOG_NARRATOR_INSPECT_CODE=true

# Optional file path to export postmortem Markdown incident report upon exit
# LOG_NARRATOR_EXPORT_MARKDOWN=./postmortem.md


# ==============================================================================
# 3. TUNING, RESILIENCY & ADVANCED EXTENSIONS
# ==============================================================================

# Maximum API retries with exponential backoff on transient errors or quota limits
LOG_NARRATOR_MAX_RETRIES=3

# Token count threshold to trigger automatic rolling context compaction
# Prevents context window exhaustion on long-running continuous tailing sessions
LOG_NARRATOR_COMPACTION_TOKEN_THRESHOLD=40000

# Enforce schema-validated structured JSON output (IncidentDossier) instead of prose
LOG_NARRATOR_STRUCTURED_OUTPUT=false

# External Model Context Protocol (MCP) tool servers (comma-separated or repeated)
# Example: k8s=http://localhost:9090/sse,db=stdio:my_db_tool
# LOG_NARRATOR_MCP_SERVERS=

# Budget guardrails: maximum total tokens or model calls allowed
# LOG_NARRATOR_MAX_TOTAL_TOKENS=100000
# LOG_NARRATOR_MAX_MODEL_CALLS=50

# Enable verbose Antigravity SDK and pipeline debug logging
LOG_NARRATOR_DEBUG=false
